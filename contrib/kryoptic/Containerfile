# Kryoptic PKCS#11 Software Token
# Builds libkryoptic_pkcs11.so and initializes a test token.
#
# Usage:
#   podman build -t kryoptic -f contrib/kryoptic/Containerfile contrib/kryoptic/
#   podman run --rm -v kryoptic-lib:/usr/lib/pkcs11 -v kryoptic-data:/var/lib/kryoptic kryoptic

FROM rust:1.88-slim-bookworm AS builder

# Kryoptic requires OpenSSL 3.2+ — build from Debian trixie packages
RUN echo "deb http://deb.debian.org/debian trixie main" > /etc/apt/sources.list.d/trixie.list \
    && apt-get update && apt-get install -y -t trixie \
    libssl-dev pkg-config opensc sqlite3 libsqlite3-dev \
    clang libclang-dev cmake git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone --depth 1 https://github.com/latchset/kryoptic.git . \
    && cargo build --release -p kryoptic

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates libssl3t64 opensc sqlite3 p11-kit \
    openssl libengine-pkcs11-openssl gnutls-bin \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/libkryoptic_pkcs11.so /usr/lib/pkcs11/libkryoptic_pkcs11.so
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV KRYOPTIC_CONF=/var/lib/kryoptic/token.conf
ENV KRYOPTIC_TOKEN_DIR=/var/lib/kryoptic

RUN mkdir -p /var/lib/kryoptic

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
