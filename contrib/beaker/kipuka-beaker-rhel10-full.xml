<?xml version="1.0" encoding="utf-8"?>
<job>
  <whiteboard>kipuka full-stack EST deploy: RHCS CA + KRA + EST (RHEL 10)</whiteboard>
  <recipeSet>
    <recipe whiteboard="kipuka-rhcs-full-stack">
      <distroRequires>
        <and>
          <distro_name op="=" value="RHEL-10.0-updates-20260623.1"/>
          <distro_variant op="=" value="BaseOS"/>
          <distro_arch op="=" value="x86_64"/>
        </and>
      </distroRequires>
      <hostRequires>
        <and>
          <system_type value="Machine"/>
          <memory op="&gt;=" value="16384"/>
          <cpu_count op="&gt;=" value="4"/>
          <disk_size op="&gt;=" value="80" units="GiB"/>
          <labcontroller op="=" value="lab-02.rhts.eng.rdu.redhat.com"/>
        </and>
      </hostRequires>
      <repos>
        <repo name="rhel-10-crb"
              url="http://download.eng.rdu.redhat.com/rhel-10/composes/RHEL-10/RHEL-10.0-updates-20260623.1/compose/CRB/x86_64/os/"/>
        <repo name="rhel-10-appstream"
              url="http://download.eng.rdu.redhat.com/rhel-10/composes/RHEL-10/RHEL-10.0-updates-20260623.1/compose/AppStream/x86_64/os/"/>
      </repos>
      <partitions>
        <partition name="/" size="40" type="part" fs="xfs"/>
        <partition name="/var" size="30" type="part" fs="xfs"/>
      </partitions>
      <task name="/distribution/install" role="STANDALONE"/>
      <task name="/distribution/command" role="STANDALONE">
        <params>
          <param name="CMDS_TO_RUN"
                 value="curl -sSfLk https://gitlab.cee.redhat.com/czinda/kipuka/-/raw/main/contrib/beaker/setup.sh | bash"/>
        </params>
      </task>
      <task name="/distribution/reservesys" role="STANDALONE">
        <params>
          <param name="RESERVETIME" value="172800"/>
        </params>
      </task>
    </recipe>
  </recipeSet>
</job>
