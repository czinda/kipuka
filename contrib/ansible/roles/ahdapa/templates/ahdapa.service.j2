# ahdapa Rust CA Server systemd service
# Generated by Ansible — managed file, do not edit by hand

[Unit]
Description=ahdapa Rust IPA/CA Server
Documentation=https://codeberg.org/freeipa/ahdapa
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ ahdapa_user }}
Group={{ ahdapa_group }}

ExecStart={{ ahdapa_install_dir }}/ahdapa serve

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

ReadWritePaths={{ ahdapa_data_dir }}

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ahdapa

[Install]
WantedBy=multi-user.target
