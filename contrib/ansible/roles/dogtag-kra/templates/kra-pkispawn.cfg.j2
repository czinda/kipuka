# pkispawn configuration for Dogtag KRA
# Generated by Ansible — do not edit by hand
#
# The KRA subsystem joins the existing CA instance and security domain
# to provide key archival and recovery for /serverkeygen.

[DEFAULT]
pki_instance_name = {{ dogtag_instance_name }}
pki_admin_password = {{ dogtag_admin_password }}
pki_ds_password = {{ ds_root_password }}
pki_ds_hostname = {{ groups['ds_servers'][0] }}
pki_ds_ldap_port = {{ ds_port }}
pki_ds_base_dn = {{ ds_suffix }}
pki_security_domain_hostname = {{ groups['ca_servers'][0] }}
pki_security_domain_https_port = 8443
pki_security_domain_name = {{ dogtag_security_domain }}
pki_hostname = {{ inventory_hostname }}

[KRA]
pki_import_admin_cert = True
