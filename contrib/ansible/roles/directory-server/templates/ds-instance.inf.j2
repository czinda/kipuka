# 389 Directory Server instance configuration
# Generated by Ansible — do not edit by hand
#
# See: https://www.port389.org/docs/389ds/howto/quickstart.html

[general]
config_version = 2
full_machine_name = {{ inventory_hostname }}
strict_host_checking = False

[slapd]
instance_name = {{ ds_instance_name }}
root_dn = {{ ds_root_dn }}
root_password = {{ ds_root_password }}
port = {{ ds_port }}
secure_port = {{ ds_secure_port }}

[backend-userroot]
create_suffix_entry = True
suffix = {{ ds_suffix }}
