# kipuka EST Server systemd service
# Generated by Ansible — managed file, do not edit by hand
# Template: roles/kipuka/templates/kipuka.service.j2

[Unit]
Description=Kipuka EST Server (RFC 7030)
Documentation=https://codeberg.org/czinda/kipuka
After=network-online.target
Wants=network-online.target
{% if kipuka_db_backend == "postgres" %}
After=postgresql.service
{% elif kipuka_db_backend == "mariadb" %}
After=mariadb.service
{% endif %}

[Service]
Type=notify
User={{ kipuka_user }}
Group={{ kipuka_group }}

ExecStart={{ kipuka_install_dir }}/kipuka serve --config {{ kipuka_config_dir }}/kipuka.toml
ExecReload=/bin/kill -HUP $MAINPID

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes

# Allow binding to privileged ports if needed
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Writable paths
ReadWritePaths={{ kipuka_data_dir }} {{ kipuka_log_dir }}

# Restart policy
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kipuka

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
