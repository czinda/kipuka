# kipuka EST Server Configuration
# Generated by Ansible — managed file, do not edit by hand
# Template: roles/kipuka/templates/kipuka.toml.j2

# ── Server ────────────────────────────────────────────────────────────────────

[server]
listen_addr = "{{ kipuka_listen_addr }}:{{ kipuka_listen_port }}"
max_body_size = 65536
shutdown_timeout_secs = 30

# ── TLS ───────────────────────────────────────────────────────────────────────

[tls]
enabled = true
cert_file = "{{ kipuka_tls_cert }}"
key_file = "{{ kipuka_tls_key }}"
ca_file = "{{ kipuka_tls_ca_file }}"
min_version = "{{ kipuka_tls_min_version }}"

# ── Database ──────────────────────────────────────────────────────────────────

[database]
url = "{{ kipuka_db_url }}"

# ── Certificate Authority ─────────────────────────────────────────────────────

[[ca]]
id = "default"
is_default = true
key_file = "{{ kipuka_config_dir }}/ca/ca.key"
cert_file = "{{ kipuka_config_dir }}/ca/ca.pem"
key_type = "{{ kipuka_ca_key_type }}"
validity_days = {{ kipuka_ca_validity_days }}
common_name = "{{ kipuka_ca_common_name }}"
organization = "{{ kipuka_ca_organization }}"
{% if kipuka_hsm_enabled %}
pkcs11_uri = "pkcs11:token={{ kipuka_hsm_token_label }};object=ca-key;type=private"
{% endif %}

# ── EST Protocol ──────────────────────────────────────────────────────────────

[est]
simpleenroll = {{ kipuka_est_simpleenroll | lower }}
simplereenroll = {{ kipuka_est_simplereenroll | lower }}
fullcmc = {{ kipuka_est_fullcmc | lower }}
serverkeygen = {{ kipuka_est_serverkeygen | lower }}
csrattrs = {{ kipuka_est_csrattrs | lower }}

# ── OTP Authentication ───────────────────────────────────────────────────────

[otp]
enabled = {{ kipuka_otp_enabled | lower }}
token_length = {{ kipuka_otp_token_length }}
default_ttl = "{{ kipuka_otp_default_ttl }}"
hash_algorithm = "{{ kipuka_otp_hash_algorithm }}"

# ── Audit Logging ─────────────────────────────────────────────────────────────

[audit]
enabled = true
file = "{{ kipuka_log_dir }}/audit.log"
events = ["all"]

{% if kipuka_hsm_enabled %}
# ── HSM / PKCS#11 ─────────────────────────────────────────────────────────────

[hsm]
provider = "{{ kipuka_hsm_provider }}"
library_path = "{{ kipuka_hsm_library_path }}"
pin = "{{ kipuka_hsm_pin }}"
{% if kipuka_hsm_slot_id is defined %}
slot_id = {{ kipuka_hsm_slot_id }}
{% endif %}
{% if kipuka_hsm_token_label is defined %}
token_label = "{{ kipuka_hsm_token_label }}"
{% endif %}
max_sessions = {{ kipuka_hsm_max_sessions }}
{% endif %}

{% if kipuka_ha_enabled %}
# ── High Availability ─────────────────────────────────────────────────────────

[ha]
enabled = true
strategy = "{{ kipuka_ha_strategy }}"
check_interval = "{{ kipuka_ha_check_interval }}"
failure_threshold = {{ kipuka_ha_failure_threshold }}
{% endif %}

{% if kipuka_admin_enabled %}
# ── Admin API ─────────────────────────────────────────────────────────────────

[admin]
enabled = true
listen_addr = "127.0.0.1:{{ kipuka_admin_port }}"
auth = "mtls"
{% endif %}
