<?xml version="1.0" encoding="UTF-8"?>
<!--
  EST Server Certificate Profile for Dogtag CA
  Generated by Ansible — used by kipuka for /simpleenroll
-->
<Profile id="estServerCert">
    <classId>caEnrollImpl</classId>
    <name>EST Server Certificate Enrollment</name>
    <description>Certificate profile for EST enrollment via kipuka</description>
    <enabled>true</enabled>
    <visible>false</visible>
    <auth id="certUserDBAuthMgr"/>
    <Input id="i1">
        <classId>certReqInputImpl</classId>
        <Name>Certificate Request Input</Name>
    </Input>
    <Output id="o1">
        <classId>certOutputImpl</classId>
        <Name>Certificate Output</Name>
    </Output>
    <PolicySet id="serverCertSet">
        <Policy id="1" classId="signingAlgDefaultImpl">
            <constraint classId="signingAlgConstraintImpl"/>
            <default>
                <Attribute name="signingAlg" syntax="string" constraint="true">
                    <Descriptor>
                        <Syntax>string</Syntax>
                        <Description>Signing Algorithm</Description>
                    </Descriptor>
                    <Value>{{ dogtag_ca_signing_algorithm }}</Value>
                </Attribute>
            </default>
        </Policy>
        <Policy id="2" classId="validityDefaultImpl">
            <constraint classId="validityConstraintImpl">
                <Attribute name="range" syntax="integer">
                    <Value>398</Value>
                </Attribute>
            </constraint>
            <default>
                <Attribute name="range" syntax="integer">
                    <Value>398</Value>
                </Attribute>
            </default>
        </Policy>
    </PolicySet>
</Profile>
