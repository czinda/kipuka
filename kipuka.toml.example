# kipuka EST Server Configuration
# =================================
# Copy this file to kipuka.toml and adjust for your environment.
# All paths are relative to the working directory unless absolute.

# ── Server ────────────────────────────────────────────────────────────────────

[server]
# Listen address and port for the EST HTTPS endpoint.
listen = "0.0.0.0:8443"

# Optional administrative API (bind to localhost or internal network only).
# admin_listen = "127.0.0.1:9443"

# Worker threads (defaults to number of CPU cores).
# workers = 4

# Request body size limit in bytes (default: 1 MiB).
# max_body_size = 1048576

# Graceful shutdown timeout in seconds.
# shutdown_timeout = 30

# ── TLS ───────────────────────────────────────────────────────────────────────

[tls]
# Server certificate and private key for the EST HTTPS endpoint.
# The certificate MUST include the id-kp-cmcRA extended key usage (RFC 7030 S3.3.2)
# or clients will reject the TLS connection.
cert = "/etc/kipuka/tls/server.pem"
key = "/etc/kipuka/tls/server.key"

# Minimum TLS version. Only TLS 1.2 and 1.3 are supported.
# min_version = "1.2"

# Allowed cipher suites (TLS 1.2 only; TLS 1.3 suites are always enabled).
# Defaults to AEAD-only suites. Uncomment to restrict further.
# cipher_suites = [
#     "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
#     "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
#     "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
#     "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
# ]

[tls.client_auth]
# Trust anchors for mTLS client certificate verification.
# Used for /simplereenroll and optionally /simpleenroll.
trust_anchors = "/etc/kipuka/tls/client-ca-bundle.pem"

# Client certificate verification mode:
#   "required" - all connections must present a valid client cert
#   "optional" - client cert requested but not required (allows OTP fallback)
#   "none"     - no client cert requested
# Default: "optional" (allows both mTLS and OTP authentication).
# mode = "optional"

# ── Database ──────────────────────────────────────────────────────────────────

[db]
# Database URL. Supported backends:
#   SQLite:     sqlite:///var/lib/kipuka/kipuka.db
#   PostgreSQL: postgres://user:pass@host:5432/kipuka
#   MariaDB:    mysql://user:pass@host:3306/kipuka
url = "sqlite:///var/lib/kipuka/kipuka.db"

# Maximum number of database connections in the pool.
# max_connections = 10

# Connection timeout in seconds.
# connect_timeout = 5

# Run migrations automatically on startup (default: false).
# For production, use `kipuka migrate` instead.
# auto_migrate = false

# ── Certificate Authorities ───────────────────────────────────────────────────
# Define one or more CA configurations. Each [[ca]] block is a separate CA
# that can issue certificates. Use the `id` to reference CAs in EST labels.

[[ca]]
# Unique identifier for this CA. Referenced by EST labels and HA groups.
id = "rsa-ca"

# Display name (used in logs and admin API).
name = "RSA Issuing CA"

# CA certificate (PEM). This is the issuing CA certificate, not the root.
cert = "/etc/kipuka/ca/rsa-ca.pem"

# CA private key (PEM). Omit if the key is stored in an HSM.
key = "/etc/kipuka/ca/rsa-ca.key"

# Full certificate chain from this CA up to (but not including) the root.
# Returned by /cacerts. If omitted, only the CA cert is returned.
# chain = "/etc/kipuka/ca/rsa-ca-chain.pem"

# Default certificate validity period.
# validity_days = 398

# Maximum allowed validity (CA/B Forum BR limit).
# max_validity_days = 398

# Key usage constraints for issued certificates.
# default_key_usage = ["digitalSignature", "keyEncipherment"]

# Extended key usage constraints.
# default_ext_key_usage = ["serverAuth", "clientAuth"]

# HSM slot for this CA's private key (omit for file-based keys).
# hsm_slot = "rsa-ca-slot"

[[ca]]
id = "ecdsa-ca"
name = "ECDSA Issuing CA"
cert = "/etc/kipuka/ca/ecdsa-ca.pem"
key = "/etc/kipuka/ca/ecdsa-ca.key"
# chain = "/etc/kipuka/ca/ecdsa-ca-chain.pem"
# validity_days = 398
# default_key_usage = ["digitalSignature"]
# default_ext_key_usage = ["serverAuth", "clientAuth"]

# Post-Quantum CA (FIPS 204, requires OpenSSL 3.5+).
# ML-DSA uses a built-in hash — no separate hash_algorithm needed.
# [[ca]]
# id = "pqc-ca"
# name = "ML-DSA-65 Issuing CA"
# cert = "/etc/kipuka/ca/mldsa65-ca.pem"
# key = "/etc/kipuka/ca/mldsa65-ca.key"
# key_type = "ml-dsa-65"
# hash_algorithm = "none"
# validity_days = 398

# ── EST Protocol ──────────────────────────────────────────────────────────────

[est]
# Base path for EST endpoints (RFC 7030 S3.2.2).
# Default: "/.well-known/est"
# base_path = "/.well-known/est"

# Enable or disable individual EST operations.
# All are enabled by default.
# cacerts = true
# simpleenroll = true
# simplereenroll = true

# Full CMC via EST (RFC 7030 S4.3 / RFC 5272).
# Accepts application/pkcs7-mime CMC requests and proxies to the CA CMC
# infrastructure. Requires id-kp-cmcRA EKU on the authenticated client.
fullcmc = true

# Server-side key generation (RFC 7030 S4.4).
# Generates key pairs on behalf of clients and returns both the certificate
# and private key. Integrates with Dogtag KRA when [dogtag] is configured.
serverkeygen = true

# CSR attributes endpoint.
csrattrs = true

# CSR attributes to request from clients (returned by /csrattrs).
# OID values per RFC 7030 S4.5.2.
# csr_attributes = [
#     "1.2.840.113549.1.9.7",   # challengePassword
#     "1.2.840.10045.4.3.2",    # ecdsaWithSHA256
#     "1.2.840.113549.1.1.11",  # sha256WithRSAEncryption
# ]

# ── EST Renewal Info (draft-ietf-lamps-est-renewal-info) ─────────────────────
# renewal_window_days = 30          # Days before expiry to start renewal window
# renewal_retry_after_secs = 86400  # Retry-After header for client polling

# ── CMC Truststore ──────────────────────────────────────────────────────────
# PEM file with trust anchors for CMC RA signer verification.
# When set, /fullcmc accepts RA certs issued by CAs other than the target.
# cmc_truststore_file = "/etc/kipuka/cmc-trust-anchors.pem"

# ── CSR Template (RFC 9908) ─────────────────────────────────────────────────
# Server-specified CSR template returned alongside the OID list in /csrattrs.
# [est.csr_template]
# key_algorithm = "ec:P-256"
# required_extensions = ["2.5.29.17"]  # subjectAltName
#
# [[est.csr_template.subject]]
# oid = "2.5.4.10"                     # organizationName
# value = "Example Corp"               # pre-filled
#
# [[est.csr_template.subject]]
# oid = "2.5.4.3"                      # commonName (client fills)

# Retry-After header value (seconds) when CA is temporarily unavailable.
# retry_after = 120

# ── EST Labels ────────────────────────────────────────────────────────────────
# Labels allow different certificate profiles via the EST path:
#   /.well-known/est/<label>/simpleenroll
# Each label maps to a CA and optional profile constraints.

# [[est.label]]
# name = "server-tls"
# ca_id = "rsa-ca"
# # Certificate profile constraints for this label.
# allowed_key_types = ["rsa:2048", "rsa:4096", "ec:p256", "ec:p384"]
# required_ext_key_usage = ["serverAuth"]
# max_validity_days = 398
# require_san = true

# [[est.label]]
# name = "client-auth"
# ca_id = "ecdsa-ca"
# allowed_key_types = ["ec:p256", "ec:p384"]
# required_ext_key_usage = ["clientAuth"]
# max_validity_days = 398

# [[est.label]]
# name = "device"
# ca_id = "rsa-ca"
# allowed_key_types = ["rsa:2048", "ec:p256"]
# required_ext_key_usage = ["clientAuth"]
# max_validity_days = 825
# # Restrict to specific Subject DN pattern.
# subject_pattern = "CN=device-.*,O=Example Corp"

# Post-quantum enrollment label (requires pqc-ca above).
# [[est.label]]
# name = "pqc"
# ca_id = "pqc-ca"
# allowed_key_types = ["ml-dsa-44", "ml-dsa-65", "ml-dsa-87"]
# required_ext_key_usage = ["clientAuth"]
# max_validity_days = 398

# ── HSM ───────────────────────────────────────────────────────────────────────
# PKCS#11 HSM integration for protecting CA private keys.
# Only needed if any [[ca]] block uses hsm_slot instead of a key file.

# [hsm]
# PKCS#11 library path. Varies by vendor:
#
# Entrust nShield:
#   library = "/opt/nfast/toolkits/pkcs11/libcknfast.so"
#
# Utimaco CryptoServer:
#   library = "/usr/lib/libcs_pkcs11_R3.so"
#
# Kryoptic (dev/test):
#   library = "/usr/lib/libkryoptic_pkcs11.so"
#
# Thales Luna (CSP11):
#   library = "/usr/safenet/lunaclient/lib/libCryptoki2_64.so"

# library = "/usr/lib/pkcs11/libsofthsm2.so"

# PKCS#11 slot number or token label.
# slot = 0
# token_label = "kipuka-hsm"

# PIN for the HSM slot. For production, use pin_env or pin_file.
# pin = "1234"

# Read PIN from an environment variable (preferred for containers).
# pin_env = "KIPUKA_HSM_PIN"

# Read PIN from a file (must be mode 0400, owned by the kipuka user).
# pin_file = "/etc/kipuka/hsm.pin"

# ── OTP Authentication ───────────────────────────────────────────────────────

[otp]
# Enable OTP-based authentication for initial enrollment.
enabled = true

# OTP token length (characters). Must be >= 16 for NIAP compliance.
token_length = 24

# Default OTP validity period.
default_ttl = "24h"

# Maximum number of uses per OTP token (default: 1 for one-time use).
# max_uses = 1

# Hash algorithm for stored OTP tokens (argon2id, bcrypt, sha256-hmac).
# argon2id is recommended for NIAP compliance.
hash_algorithm = "argon2id"

# Rate limiting: max failed OTP attempts per source IP per window.
# max_failures = 5
# failure_window = "15m"
# lockout_duration = "30m"

# ── Audit Logging ─────────────────────────────────────────────────────────────

[audit]
# Audit log destination. Events are always stored in the database.
# Additional destinations can be configured here.

# File-based audit log (append-only, one JSON event per line).
# file = "/var/log/kipuka/audit.log"

# Syslog destination (RFC 5424).
# syslog = "udp://127.0.0.1:514"
# syslog_facility = "local0"

# Events to log. Default: all security-relevant events (NIAP FAU_GEN.1).
# Possible values: all, auth, enroll, revoke, admin, config, startup, error
# events = ["all"]

# Include full certificate DER in enrollment events (increases log size).
# include_cert_data = false

# ── High Availability ─────────────────────────────────────────────────────────

# [ha]
# Enable HA failover across multiple CA backends.
# enabled = false

# Failover strategy:
#   "active-passive" - use primary CA, fail over to secondary on error
#   "round-robin"    - distribute requests across all healthy CAs
#   "weighted"       - distribute by weight (requires ca weight settings)
# strategy = "active-passive"

# Health check interval.
# check_interval = "30s"

# Number of consecutive failures before marking a CA as unhealthy.
# failure_threshold = 3

# Time to wait before retrying a failed CA.
# recovery_timeout = "60s"

# Health check timeout per CA.
# check_timeout = "10s"

# ── HA Group ──────────────────────────────────────────────────────────────────
# Group CAs together for HA. CAs must be defined in [[ca]] blocks above.

# [[ha.group]]
# name = "rsa-ha"
# ca_ids = ["rsa-ca-primary", "rsa-ca-secondary"]
# strategy = "active-passive"

# [[ha.group]]
# name = "ecdsa-ha"
# ca_ids = ["ecdsa-ca-1", "ecdsa-ca-2", "ecdsa-ca-3"]
# strategy = "round-robin"

# ── Dogtag PKI Backend ────────────────────────────────────────────────────────
# Connect to a Dogtag CA (and optionally KRA) for enrollment and key generation.
# When configured, enrollment requests are proxied to Dogtag instead of the
# local file-based CA.

# [dogtag]
# # Dogtag CA REST API URL.
# ca_url = "https://pki.example.com:8443"
#
# # Agent certificate and key for authenticating to Dogtag.
# agent_cert_file = "/etc/kipuka/dogtag/agent.pem"
# agent_key_file = "/etc/kipuka/dogtag/agent-key.pem"
#
# # Dogtag CA certificate for TLS verification.
# ca_cert_file = "/etc/kipuka/dogtag/ca-chain.pem"
#
# # Enrollment profile ID on the Dogtag CA.
# profile_id = "caServerCert"
#
# # KRA URL for /serverkeygen key generation and archival (optional).
# kra_url = "https://pki.example.com:8443"
#
# # Whether to archive generated keys in the KRA (default: false).
# archive_keys = false

# ── CMP Protocol ─────────────────────────────────────────────────────────────
# Certificate Management Protocol (RFC 4210) handler.
# Supports both signature-based and MAC-based protection verification.

# [cmp]
# enabled = true
#
# # Shared secrets for MAC-based CMP protection (reference ID -> secret).
# # For production, use mac_secrets_file or mac_secrets_env.
# [cmp.mac_secrets]
# "reference-id-1" = "shared-secret-value"
# "device-bootstrap" = "another-secret"
#
# # Or load MAC secrets from a file (JSON: {"ref-id": "secret", ...}).
# # mac_secrets_file = "/etc/kipuka/cmp/mac-secrets.json"

# ── GSSAPI / Kerberos Authentication ────────────────────────────────────────
# Enable GSSAPI (Kerberos) authentication for EST enrollment.
# Requires a keytab and principal for the EST service.

# [gssapi]
# enabled = true
#
# # Kerberos keytab file for the EST service principal.
# keytab = "/etc/kipuka/krb5.keytab"
#
# # Service principal name (default: HTTP/<hostname>@<REALM>).
# principal = "HTTP/est.example.com@EXAMPLE.COM"
#
# # Allowed client principal patterns (regex). If empty, all authenticated
# # principals are allowed.
# allowed_principals = [".*@EXAMPLE\\.COM"]
#
# # Whether to use the libgssapi FFI backend (default: false, uses native Rust).
# use_ffi = false

# ── Admin API ─────────────────────────────────────────────────────────────────

# [admin]
# Enable the administrative API for OTP provisioning and CA management.
# enabled = false

# Authentication for admin API.
# auth = "mtls"  # "mtls", "bearer", or "both"

# Admin client certificate trust anchors (for mTLS auth).
# trust_anchors = "/etc/kipuka/admin/admin-ca.pem"

# Bearer token for admin API (use bearer_token_env for production).
# bearer_token_env = "KIPUKA_ADMIN_TOKEN"

# ── CoAP/DTLS Transport ─────────────────────────────────────────────────
# CoAP over DTLS transport for constrained IoT devices (RFC 9483).
# Provides EST-coaps: EST over CoAP with block-wise transfer support
# for resource-constrained environments (sensors, actuators, etc.).

# [coap]
# enabled = false
#
# # UDP listen address for CoAP/DTLS endpoint.
# listen_addr = "0.0.0.0:5684"
#
# # Enable DTLS for the CoAP listener (strongly recommended; disable only
# # for debugging on isolated networks).
# dtls_enabled = true
#
# # CoAP block-wise transfer size in bytes (64, 128, 256, 512, 1024).
# # Smaller values for very constrained devices; 512 is a good default.
# block_size = 512
#
# # Maximum reassembled payload size in bytes (protects against resource
# # exhaustion from oversized requests).
# max_payload = 65536
#
# # DTLS session timeout in seconds for constrained device resumption.
# session_timeout_secs = 300
#
# # Maximum number of concurrent DTLS sessions.
# max_sessions = 1024

# ── CMS-wrapped EST ─────────────────────────────────────────────────────
# CMS (Cryptographic Message Syntax) wrapped EST endpoints (RFC 8295).
# Adds CMS SignedData wrapping on requests and CMS EnvelopedData encryption
# on responses for environments requiring end-to-end message-layer security.

# [cms_est]
# enabled = false
#
# # Require CMS SignedData wrapping on all EST requests.
# require_signed_requests = true
#
# # Encrypt responses using CMS EnvelopedData.
# encrypt_responses = true
#
# # Allowed content-encryption algorithms for CMS EnvelopedData.
# allowed_content_encryption = ["AES-256-GCM", "AES-128-GCM"]

# ── STAR Certificates ───────────────────────────────────────────────────
# Short-Term Automatically Renewed (STAR) certificates (RFC 8739).
# Issues short-lived certificates that auto-renew on a schedule, reducing
# the need for revocation infrastructure. Useful for CDNs and TLS proxies.

# [star]
# enabled = false
#
# # Minimum renewal interval in seconds (floor: 3600 = 1 hour).
# min_renewal_interval_secs = 3600
#
# # Maximum renewal interval in seconds (ceiling: 604800 = 7 days).
# max_renewal_interval_secs = 604800
#
# # Default renewal interval when the client does not specify one (86400 = 24h).
# default_renewal_interval_secs = 86400
#
# # Maximum total STAR order lifetime in days.
# max_lifetime_days = 365
#
# # Maximum number of active STAR orders (resource exhaustion guard).
# max_active_orders = 10000
#
# # Renew when this fraction of the interval remains (0.1 - 0.9).
# pre_renewal_factor = 0.5

# ── OCSP Revocation Checking ────────────────────────────────────────────
# Online Certificate Status Protocol (RFC 6960) checking for client
# certificates presented during mTLS enrollment. Verifies that client
# certificates have not been revoked before accepting enrollment requests.

# [ocsp]
# enabled = false
#
# # Override OCSP responder URL. When omitted, the AIA extension from the
# # client certificate is used (RFC 5280 S4.2.2.1).
# # responder_url = "http://ocsp.example.com:9080"
#
# # Cache TTL in seconds for OCSP responses (default: 300 = 5 minutes).
# cache_ttl_secs = 300
#
# # HTTP timeout in seconds for OCSP requests.
# timeout_secs = 10
#
# # Require a nonce in OCSP responses (RFC 6960 S4.4.1).
# # Nonces prevent replay attacks but not all responders support them.
# require_nonce = true
#
# # Soft-fail mode: if true, accept the certificate when the OCSP responder
# # is unreachable. If false, reject. Set to true for availability over
# # strict revocation enforcement.
# soft_fail = false
