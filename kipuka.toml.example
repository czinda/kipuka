# Kipuka deployment example. Replace paths with your certificate/key locations.
# Database migrations run at startup. There is no `migrate` subcommand.
# TLS private keys and credentials must be provisioned separately.

[server]
listen_addr = "0.0.0.0:8443"
max_body_size = 1048576

[tls]
cert_file = "/etc/kipuka/tls/server.pem"
key_file = "/etc/kipuka/tls/server.key"
ca_file = "/etc/kipuka/tls/client-ca-bundle.pem"

[database]
# Create /var/lib/kipuka with ownership allowing the server to write.
url = "sqlite:///var/lib/kipuka/kipuka.db?mode=rwc"
run_migrations = true
sqlite_wal = true
# For remote databases use a secret reference, e.g. url = "env:KIPUKA_DB_URL".

[[ca]]
id = "main"
is_default = true
cert_file = "/etc/kipuka/ca/ca.pem"
key_file = "/etc/kipuka/ca/ca.key"
validity_days = 90

[audit]
enabled = true
log_to_db = true
overflow_policy = "halt"
max_rows = 1000000
alarm_threshold = 10
alarm_action = "syslog"
# Signed records and custom file rotation are unsupported and rejected.
# Forward server logs and provide the system syslog socket for security alarms.

# Optional custom EST renewal (not ACME STAR / RFC 8739).
# [star]
# enabled = true
# default_renewal_interval_secs = 3600
# max_lifetime_days = 365

# Optional HA. Each label must explicitly authorize its alternate issuers.
# [ha]
# enabled = true
# strategy = "active_passive"
# probe_interval_secs = 30
# failure_threshold = 3
# cooldown_secs = 60
# [[est.labels]]
# name = "devices"
# ca_pool = ["main", "secondary"] # requires a second [[ca]] entry
# auth_methods = ["otp", "mtls"]
